# Animation Studio — configuration d'exemple.
# Copiez ce fichier en .env.local et complétez uniquement ce dont vous avez besoin.
# Aucune valeur réelle ici. Ne commitez JAMAIS .env.local.
# Règle : seules les variables NEXT_PUBLIC_* atteignent le navigateur ; aucun secret n'y figure.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# demo (défaut) : aucun secret requis, moteur simulé, paiements simulés, données locales.
# live : Supabase + Trigger.dev obligatoires ; l'application refuse de démarrer sinon.
APP_MODE=demo
APP_BASE_URL=http://localhost:3000

# Interrupteurs de dépenses. Restent false tant que le propriétaire ne l'a pas décidé.
# Une clé présente n'est PAS une autorisation de dépense.
REAL_GENERATION_ENABLED=false
VOICE_GENERATION_ENABLED=false
STRIPE_LIVE_ENABLED=false

# ---------------------------------------------------------------------------
# Démo locale
# ---------------------------------------------------------------------------
# Secret de signature des sessions et liens média de démo (32+ caractères aléatoires).
# Ignoré en live. Laissé vide : secret de développement fixe, à ne pas exposer publiquement.
DEMO_SECRET=
DEMO_DATA_DIR=.demo-data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---------------------------------------------------------------------------
# Supabase (live) — Auth, Postgres (RLS), Storage privé
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# Trigger.dev (live) — tâches longues de génération
# ---------------------------------------------------------------------------
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# ---------------------------------------------------------------------------
# Hedra (live, payant) — moteur vidéo
# ---------------------------------------------------------------------------
HEDRA_API_KEY=
HEDRA_API_BASE_URL=https://api.hedra.com/v3
HEDRA_MODEL_ID=hedra-character-3
# Clé publique ed25519 des webhooks Hedra (optionnel ; sans elle, le suivi se fait par interrogation).
HEDRA_WEBHOOK_PUBLIC_KEY=
# Tarif vérifié MANUELLEMENT par le propriétaire sur la page officielle, en micro-unités
# de COST_CURRENCY par seconde (25000 = 0,025 USD/s). Sans ces 4 valeurs, la génération
# réelle reste bloquée. Valeurs indicatives lues le 2026-10-08 : 25000 / 50000 / 62500.
HEDRA_PRICE_VERSION=
HEDRA_RATE_MICROS_540P=
HEDRA_RATE_MICROS_720P=
HEDRA_RATE_MICROS_1080P=

# ---------------------------------------------------------------------------
# ElevenLabs (optionnel, payant) — voix à partir d'un texte
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Coût estimé en unités mineures de COST_CURRENCY pour 1000 caractères (à vérifier sur votre offre).
ELEVENLABS_COST_MINOR_PER_1K_CHARS=

# ---------------------------------------------------------------------------
# Stripe — Checkout en mode TEST (sk_test_...). Une clé sk_live_ est refusée
# tant que STRIPE_LIVE_ENABLED n'est pas true.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Plafonds et économie des crédits (unités mineures = centimes)
# ---------------------------------------------------------------------------
COST_CURRENCY=USD
# Coût fournisseur maximal d'UNE génération (obligatoire en live). Ex. 200 = 2,00 USD.
MAX_GENERATION_COST_MINOR=
# Budget fournisseur total par jour UTC (obligatoire en live). Ex. 1000 = 10,00 USD.
DAILY_PROVIDER_BUDGET_MINOR=
MAX_VIDEO_DURATION_SECONDS=30
MAX_CONCURRENT_JOBS_PER_USER=1
# Valeur d'un crédit en unités mineures et marge appliquée (15000 = x1,5).
CREDIT_VALUE_MINOR=5
CREDIT_MARKUP_BPS=15000
SIGNUP_BONUS_CREDITS=0

# ---------------------------------------------------------------------------
# Observabilité (optionnel)
# ---------------------------------------------------------------------------
SENTRY_DSN=
